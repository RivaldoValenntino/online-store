APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=online_store
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

BITESHIP_WEBHOOK_HEADER_KEY=X-Biteship-Signature
BITESHIP_WEBHOOK_SECRET=

# Customer Service & WhatsApp CTA
CS_NAME="CS ${APP_NAME}"
CS_PHONE=
CS_IS_ACTIVE=true
HOMEPAGE_CS_TITLE="Masih Bingung Memilih Produk?"
HOMEPAGE_CS_SUBTITLE="Butuh hampers khusus atau tanya stok?"
HOMEPAGE_CS_DESCRIPTION="Konsultasikan kebutuhan oleh-oleh khas Garut atau pesanan dalam jumlah besar langsung dengan Customer Service kami."
HOMEPAGE_CS_BUTTON_TEXT="Hubungi CS via WhatsApp"
HOMEPAGE_CS_MESSAGE="Halo Customer Service ${APP_NAME}, saya ingin bertanya seputar rekomendasi oleh-oleh khas Garut atau pesanan khusus."

# Filament Admin HTTP Basic Authentication Gate
ADMIN_BASIC_AUTH_ENABLED=false
ADMIN_BASIC_AUTH_USERNAME=
ADMIN_BASIC_AUTH_PASSWORD=
ADMIN_BASIC_AUTH_REALM="Podo Raos Admin Area"


